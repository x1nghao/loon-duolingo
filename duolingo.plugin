[Script]
http-response ^https?:\/\/ios-api-2\.duolingo\.cn script-path=https://raw.githubusercontent.com/x1nghao/loon-duolingo/main/duolingo_gems.js, requires-body=true, timeout=10, max-size=600000, tag=多邻国 响应拦截

http-response ^https?:\/\/duolingo-achievements-prod\.duolingo\.cn script-path=https://raw.githubusercontent.com/x1nghao/loon-duolingo/main/duolingo_gems.js, requires-body=true, timeout=10, max-size=200000, tag=多邻国 成就域响应

http-response ^https?:\/\/api2\.duolingo\.cn script-path=https://raw.githubusercontent.com/x1nghao/loon-duolingo/main/duolingo_gems.js, requires-body=true, timeout=10, max-size=600000, tag=多邻国 api2 响应拦截

[Mitm]
hostname = ios-api-2.duolingo.cn, duolingo-achievements-prod.duolingo.cn, api2.duolingo.cn
